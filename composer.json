{
    "name": "pulsenote/pulsenote-php",
    "description": "Official PHP SDK for the Pulsenote email API.",
    "type": "library",
    "keywords": ["pulsenote", "email", "sdk", "api-client", "notifications"],
    "homepage": "https://pulsenote.eu",
    "license": "MIT",
    "authors": [
        {
            "name": "GP IT-Tech",
            "homepage": "https://pulsenote.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/Pulsenote/pulsenote-php/issues",
        "source": "https://github.com/Pulsenote/pulsenote-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/config": "^10.0 || ^11.0 || ^12.0",
        "illuminate/notifications": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client, auto-discovered by this SDK (^7.4)",
        "symfony/http-client": "An alternative PSR-18 HTTP client (^6.0 || ^7.0)",
        "illuminate/support": "Enables the Laravel service provider, facade, and notification channel (^10.0 || ^11.0 || ^12.0)"
    },
    "autoload": {
        "psr-4": {
            "Pulsenote\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pulsenote\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "check": ["@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Pulsenote\\Laravel\\PulsenoteServiceProvider"
            ],
            "aliases": {
                "Pulsenote": "Pulsenote\\Laravel\\Facades\\Pulsenote"
            }
        }
    }
}
